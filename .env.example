# 텔레그램 봇 (BotFather에서 받은 토큰, 내 텔레그램 숫자 ID)
TELEGRAM_TOKEN=
ALLOWED_USER_ID=

# 디스코드 봇 (개발자 포털에서 받은 토큰, 내 디스코드 숫자 ID)
DISCORD_TOKEN=
DISCORD_ALLOWED_USER_ID=

# 인스타 부계정 아이디 (비밀번호는 넣지 않는다. 로그인은 세션 파일로)
IG_USER=

# 요약: Claude 구독(Claude Code). `claude setup-token`으로 받은 토큰
CLAUDE_CODE_OAUTH_TOKEN=
# haiku / sonnet / opus
CLAUDE_MODEL=sonnet

# 옵시디언 vault 폴더 (6단계에서 설정)
VAULT_DIR=

# 음성 변환 모델 (base: 빠름 / small: 정확)
WHISPER_MODEL=small
